########################################
# App
########################################

# Note: don't set NODE_ENV here — Next.js manages it per command
# (dev = development, build/start = production) and overriding it breaks builds.

APP_NAME=CareerOS

# CareerOS is a single local process: UI, API, and extension endpoint all on one origin.
APP_URL=http://localhost:3000


########################################
# Database
########################################

# SQLite: the entire database is this one file. Copy it to back it up.
DATABASE_URL=file:./data/careeros.db


########################################
# AI (optional — CareerOS is fully functional without any key)
########################################

# Cloud: anthropic | openai | google | openrouter (need a key below)
# Local: ollama | lmstudio (no key — AI runs entirely on your machine)
AI_PROVIDER=anthropic

# Leave blank to disable all AI features. Nothing ever leaves your machine
# unless a key is set AND you explicitly trigger an AI action.
ANTHROPIC_API_KEY=

OPENAI_API_KEY=

GOOGLE_API_KEY=

OPENROUTER_API_KEY=

# Local model runtimes (only used when AI_PROVIDER=ollama / lmstudio)
OLLAMA_URL=http://localhost:11434

LMSTUDIO_URL=http://localhost:1234

# Optional: override the default model for the selected provider
# (e.g. claude-sonnet-4-5, gpt-4o, llama3.2, anthropic/claude-sonnet-4.5)
AI_MODEL=


########################################
# Storage
########################################

STORAGE_PROVIDER=local

STORAGE_PATH=./storage


########################################
# Email (future optional integration — not yet implemented)
########################################

GMAIL_CLIENT_ID=

GMAIL_CLIENT_SECRET=


########################################
# Browser Extension
########################################

# The extension talks to the same local app. Auth token is generated on first
# run and shown on the Settings page.
EXTENSION_API_URL=http://localhost:3000


########################################
# Logging
########################################

LOG_LEVEL=INFO
