{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CareerOS",
  "version": "1.0.0",
  "identifier": "app.careeros.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/prepare-tauri-server.mjs",
    "frontendDist": "placeholder-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Local-first career management",
    "longDescription": "CareerOS keeps your entire career — experience, achievements, applications, resumes — in one local, private database you own. No accounts, no cloud, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["server"],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
